{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "new.adamkaz.com" }],
      "destination": "https://www.istockphoto.com/portfolio/adamkaz?assettype=image&excludenudity=false&phraseprocessing=excludenaturallanguage&mediatype=photography&sort=newest",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "video.adamkaz.com" }],
      "destination": "https://www.istockphoto.com/portfolio/adamkaz?assettype=film&phraseprocessing=excludenaturallanguage&sort=best",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
